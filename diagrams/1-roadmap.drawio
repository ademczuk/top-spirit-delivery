        </mxCell>
        <mxCell id="p2b" value="&#8226; Pick one or two places to start&#xa;&#8226; Build it in short two-week rounds&#xa;&#8226; A person checks every AI output" style="text;html=1;align=left;verticalAlign=top;fontColor=#241d1f;fontSize=13;spacingLeft=2;" vertex="1" parent="p2">
