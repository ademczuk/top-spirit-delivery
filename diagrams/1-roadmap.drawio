        </mxCell>
        <mxCell id="p1b" value="&#8226; Interviews and current-state process maps&#xa;&#8226; First data-quality assessment&#xa;&#8226; Establish the baseline (measure today)" style="text;html=1;align=left;verticalAlign=top;fontColor=#241d1f;fontSize=13;spacingLeft=2;" vertex="1" parent="p1">
          <mxGeometry x="16" y="82" width="288" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1g" value="GATE 1&#xa;Baseline approved, problem statements agreed by the sponsor" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f3e2e4;strokeColor=#b6434f;fontColor=#6d232b;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="p1">
