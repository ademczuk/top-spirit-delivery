        </mxCell>
        <mxCell id="p2g" value="GATE 2&#xa;First saving proven in your numbers, your team signs it off" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f3e2e4;strokeColor=#b6434f;fontColor=#6d232b;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="p2">
