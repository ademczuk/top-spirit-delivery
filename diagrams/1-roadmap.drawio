        <mxCell id="title" value="The engagement roadmap: four gated phases" style="text;html=1;align=left;verticalAlign=middle;fontColor=#8b2e38;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Clear checkpoints protect your budget along the way, while the building happens in short, quick rounds. The timings below reflect what projects like this typically take at a company your size, and we set the real dates with you." style="text;html=1;align=left;verticalAlign=middle;fontColor=#6e6266;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1420" height="24" as="geometry" />
        </mxCell>

