        <mxCell id="p2" value="2 &#183; Quick wins" style="swimlane;html=1;startSize=42;fillColor=#8b2e38;swimlaneFillColor=#ffffff;strokeColor=#6d232b;fontColor=#ffffff;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
