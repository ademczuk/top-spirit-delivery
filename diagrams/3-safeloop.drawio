        <mxCell id="sub" value="AI drafts, a named person approves, nothing reaches a customer or the books unchecked. This is how safe and staff acceptance are designed in, not bolted on." style="text;html=1;align=left;verticalAlign=middle;fontColor=#6e6266;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1420" height="22" as="geometry" />
