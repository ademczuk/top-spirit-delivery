<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram name="Risk">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="What could go wrong, and how we prevent it" style="text;html=1;align=left;verticalAlign=middle;fontColor=#8b2e38;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="These are the ways plans like this fail. We design against each from the start, and keep them on an open list we review with you." style="text;html=1;align=left;verticalAlign=middle;fontColor=#6e6266;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1420" height="22" as="geometry" />
        </mxCell>

        <mxCell id="hr" value="The risk" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#8b2e38;strokeColor=#6d232b;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="560" height="44" as="geometry" />
        </mxCell>
        <mxCell id="hm" value="How we prevent it" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#6d232b;strokeColor=#6d232b;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="600" y="104" width="880" height="44" as="geometry" />
        </mxCell>

        <mxCell id="r1a" value="People and change under-invested" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#faf6f0;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="r1b" value="Change and training is a funded workstream from day one, not an afterthought. This is where these programs live or die." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="148" width="880" height="60" as="geometry" /></mxCell>

        <mxCell id="r2a" value="Poor data quality" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5efe6;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="r2b" value="A hard data-readiness gate before the pilot. If the data is not usable, we cleanse first rather than build on sand." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#faf6f0;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="208" width="880" height="60" as="geometry" /></mxCell>

        <mxCell id="r3a" value="Scope creep and over-tooling" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#faf6f0;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="r3b" value="Strict backlog discipline. One narrow use case at a time, starting with tools you already have. No shelf of software you never use." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="268" width="880" height="60" as="geometry" /></mxCell>

        <mxCell id="r4a" value="Big-bang release" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5efe6;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="r4b" value="Incremental releases, with a person in the loop on every AI output during the pilot to build trust and catch errors." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#faf6f0;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="328" width="880" height="60" as="geometry" /></mxCell>

        <mxCell id="r5a" value="Unclear return" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#faf6f0;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="r5b" value="A benefit attached to every initiative before any build, baselined and tracked at each gate." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="388" width="880" height="60" as="geometry" /></mxCell>

        <mxCell id="r6a" value="No clear sponsor" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f5efe6;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="r6b" value="We do not start without a named, accountable sponsor. It is the single strongest predictor of whether this works." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#faf6f0;strokeColor=#e3dacd;fontColor=#241d1f;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="600" y="448" width="880" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
